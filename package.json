{
  "name": "@colorlib/adminlte-react",
  "version": "0.1.0",
  "description": "AdminLTE 4 React/Next.js component library",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/css/adminlte.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/css/adminlte.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ColorlibHQ/adminlte-react"
  },
  "bugs": {
    "url": "https://github.com/ColorlibHQ/adminlte-react/issues"
  },
  "keywords": [
    "admin",
    "dashboard",
    "template",
    "react",
    "next",
    "bootstrap",
    "components"
  ],
  "scripts": {
    "build": "tsup && npm run copy-css && npm run add-use-client",
    "copy-css": "mkdir -p dist/css && cp node_modules/admin-lte/dist/css/adminlte.css dist/css/",
    "add-use-client": "node add-use-client.js",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "demo": "pnpm --filter adminlte-react-demo dev",
    "demo:build": "pnpm --filter adminlte-react-demo build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/sortablejs": "^1.15.9",
    "admin-lte": "^4.0.0",
    "apexcharts": "^5.13.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "flatpickr": "^4.6.13",
    "jsdom": "^29.1.1",
    "jsvectormap": "^1.7.0",
    "quill": "^2.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sortablejs": "^1.15.7",
    "tabulator-tables": "^6.4.0",
    "tom-select": "^2.6.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://adminlte.io/themes/next-react/"
}
